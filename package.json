{
  "name": "month-list",
  "version": "2.1.0",
  "type": "commonjs",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pret-a-porter/month-list.git"
  },
  "author": "Maksim Sharipov <m.v.sharipov@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "postbuild": "size-limit",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^22",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "files": [
    "lib"
  ],
  "bugs": {
    "url": "https://github.com/pret-a-porter/month-list/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "size-limit": [
    {
      "name": "All (ESM)",
      "path": "lib/index.mjs",
      "limit": "650 B"
    },
    {
      "name": "All (CJS)",
      "path": "lib/index.cjs",
      "limit": "650 B"
    },
    {
      "name": "getMonthList",
      "path": "lib/index.mjs",
      "import": "{ getMonthList }",
      "limit": "250 B"
    },
    {
      "name": "getWeekDays",
      "path": "lib/index.mjs",
      "import": "{ getWeekDays }",
      "limit": "250 B"
    },
    {
      "name": "getWeekInfo",
      "path": "lib/index.mjs",
      "import": "{ getWeekInfo }",
      "limit": "250 B"
    },
    {
      "name": "getDayPeriods",
      "path": "lib/index.mjs",
      "import": "{ getDayPeriods }",
      "limit": "250 B"
    },
    {
      "name": "getFieldNames",
      "path": "lib/index.mjs",
      "import": "{ getFieldNames }",
      "limit": "250 B"
    }
  ],
  "description": "Localized month and weekday names from Intl.DateTimeFormat"
}
